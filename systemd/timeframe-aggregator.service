[Unit]
Description=Timeframe Aggregator Service
After=network.target data-collector.service
Wants=data-collector.service

[Service]
Type=simple
User=trader
Group=trader
WorkingDirectory=/home/trader/algo_trading
Environment=PYTHONPATH=/home/trader/algo_trading
ExecStart=/usr/bin/python3 /home/trader/algo_trading/services/data/timeframe_aggregator.py
Restart=always
RestartSec=30
StandardOutput=journal
StandardError=journal
MemoryMax=256M
CPUQuota=25%

[Install]
WantedBy=multi-user.target
